# Copy this file to keystore.properties and fill in your own values.
# This is an example only. Never commit keystore.properties or the keystore.
# Relative storeFile paths are resolved from the project root.
storeFile=/absolute/path/outside/the/repository/release.keystore
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
keyPassword=REPLACE_WITH_KEY_PASSWORD
